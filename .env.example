# SentinelAI configuration.
# Copy to .env and edit. Never commit the filled-in copy.

# ---------------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------------
# demo       - self-contained: synthetic traffic, chaos endpoints, simulated PRs
# production - consumes real telemetry, opens real PRs, demo scaffolding off
SENTINEL_DEPLOYMENT_MODE=demo

# ---------------------------------------------------------------------------
# HTTP surface
# ---------------------------------------------------------------------------
# Comma-separated allowed origins. Defaults to "*" in demo and to empty
# (deny-all) in production, so you must set this to serve a dashboard.
SENTINEL_CORS_ORIGINS=https://sentinel.your-company.com

# When set, every /api route except /api/health requires an X-API-Key header
# matching this value. Generate with: openssl rand -hex 32
SENTINEL_API_KEY=

# ---------------------------------------------------------------------------
# Telemetry ingestion
# ---------------------------------------------------------------------------
# Seconds between automatic ingestion cycles. 0 disables the background poller
# and leaves ingestion manual via POST /api/ingestion/run.
# Defaults: 0 in demo, 30 in production.
SENTINEL_INGESTION_POLL_SECONDS=30

# Telemetry sources themselves are declared in config/ingestion_sources.json.
# Reference secrets from there using ${VAR} and export them here, e.g.:
PROMETHEUS_TOKEN=
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ---------------------------------------------------------------------------
# Model-backed root cause analysis
# ---------------------------------------------------------------------------
# The Diagnosis Agent uses Claude with read-only investigation tools to
# determine root cause. Without a key it falls back to a deterministic rule
# set, so the platform runs either way.
#
# Either variable works; SENTINEL_ANTHROPIC_API_KEY wins if both are set.
ANTHROPIC_API_KEY=

# Hard off switch. Set false to force the deterministic path even when a key
# is present -- used in CI and by the sandbox validation runner.
SENTINEL_LLM_ENABLED=true

SENTINEL_LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max
SENTINEL_LLM_EFFORT=high
SENTINEL_LLM_MAX_TOKENS=8000

# ---------------------------------------------------------------------------
# GitHub integration
# ---------------------------------------------------------------------------
# When disabled or incompletely configured, pull requests are simulated and
# flagged as such in the API response and UI.
SENTINEL_GITHUB_ENABLED=false

# Fine-grained PAT needs: Contents (read/write) + Pull requests (read/write)
# on the target repository. Classic PAT: the `repo` scope.
# The token needs NO merge permission by design.
SENTINEL_GITHUB_TOKEN=

# Repository that holds the AI service configuration SentinelAI patches.
SENTINEL_GITHUB_REPOSITORY=your-org/your-ai-platform
SENTINEL_GITHUB_BASE_BRANCH=main

# Override for GitHub Enterprise, e.g. https://github.your-company.com/api/v3
SENTINEL_GITHUB_API_URL=https://api.github.com

# ---------------------------------------------------------------------------
# Demo scaffolding (leave unset in production; both default off there)
# ---------------------------------------------------------------------------
# SENTINEL_ENABLE_TRAFFIC_GENERATOR=false
# SENTINEL_ENABLE_CHAOS_ENDPOINTS=false
