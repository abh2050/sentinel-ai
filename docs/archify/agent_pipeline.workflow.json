        "label": "Happy path",
        "focus": [
          "trigger",
          "detect",
          "diagnose",
          "remediate",
          "validate",
          "open_pr",
          "human_review",
          "deployed"
        ],
        "note": "Detection through a human-approved merge, in call order."
      },
      {
        "id": "safety-covenant",
        "label": "Safety covenant checks",
        "focus": [
          "detect",
          "diagnose",
          "remediate",
          "validate",
          "open_pr",
          "safety_gate",
          "human_review",
          "deployed",
          "rejected"
        ],
        "note": "Every agent calls check_permission before acting; humans bypass the AI whitelist by actor, not by a granted exception."
      }
    ]
  },
  "lanes": [
    {
      "id": "agents",
      "label": "Sentinel Agent Pipeline"
    },
    {
      "id": "safety",
      "label": "Safety Covenant"
    },
    {
      "id": "human",
      "label": "Human Review"
    },
    {
      "id": "outcomes",
      "label": "Outcome"
    }
  ],
  "mainPath": [
    "trigger",
    "detect",
    "diagnose",
    "remediate",
    "validate",
    "open_pr",
    "human_review",
    "deployed"
  ],
  "nodes": [
    {
      "id": "trigger",
      "lane": "agents",
      "col": 0,
      "width": 110,
      "type": "messagebus",
      "label": "Anomaly Detected",
      "sublabel": "check_for_anomalies()"
    },
    {
      "id": "detect",
      "lane": "agents",
      "col": 1,
      "width": 110,
      "type": "backend",
      "label": "Detection Agent",
      "sublabel": "triage + severity"
    },
    {
      "id": "diagnose",
      "lane": "agents",
      "col": 2,
      "width": 110,
      "type": "backend",
      "label": "Diagnosis Agent",
      "sublabel": "LLM RCA, rule fallback"
    },
    {
      "id": "remediate",
      "lane": "agents",
      "col": 3,
      "width": 120,
      "type": "backend",
      "label": "Remediation Agent",
      "sublabel": "synthesize config patch"
    },
    {
      "id": "validate",
      "lane": "agents",
      "col": 4,
      "width": 120,
      "type": "backend",
      "label": "Validation Agent",
      "sublabel": "sandbox tests + benchmark"
    },
    {
      "id": "open_pr",
      "lane": "agents",
      "col": 5,
      "width": 110,
      "type": "backend",
      "label": "GitHub Agent",
      "sublabel": "branch, commit, open PR"
    },
    {
      "id": "safety_gate",
      "lane": "safety",
      "col": 0,
