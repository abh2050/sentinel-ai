    {
      "id": "human_review",
      "lane": "human",
      "col": 5,
      "width": 130,
      "type": "external",
      "label": "Lead SRE Engineer",
      "sublabel": "reviews diff + scorecard"
    },
    {
      "id": "deployed",
      "lane": "outcomes",
      "col": 5,
      "width": 130,
      "type": "cloud",
      "label": "Fix Deployed",
      "sublabel": "top_k=8, reranker on"
    },
    {
      "id": "rejected",
      "lane": "outcomes",
      "col": 4,
      "width": 110,
      "type": "external",
      "label": "Rejected",
      "sublabel": "incident stays open"
    }
  ],
  "edges": [
    {
      "from": "trigger",
      "to": "detect",
      "role": "main"
    },
    {
      "from": "detect",
      "to": "diagnose",
      "role": "main"
    },
    {
      "from": "diagnose",
      "to": "remediate",
      "role": "main"
    },
    {
      "from": "remediate",
      "to": "validate",
      "role": "main"
    },
    {
      "from": "validate",
      "to": "open_pr",
      "label": "passed",
      "role": "main"
    },
    {
      "from": "validate",
      "to": "pr_withheld",
      "label": "failed",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "open_pr",
      "to": "human_review",
      "role": "main"
    },
    {
      "from": "human_review",
      "to": "deployed",
      "label": "approve → /pr/approve",
      "role": "main"
    },
    {
      "from": "human_review",
      "to": "rejected",
      "label": "reject → /pr/reject",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "from": "detect",
      "to": "safety_gate",
      "label": "check_permission() — every agent",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "The merge block is structural",
      "items": [
        "No code path ever requests AUTO_MERGE_PULL_REQUEST as an AI actor; merging sits behind POST /pr/approve, where actor==\"HUMAN_OPERATOR\" skips the whitelist (sentinel_core/safety_policy.py)"
      ]
    }
  ]
}